---
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
---

<button
  type="button"
  class="theme-toggle inline-flex size-9 items-center justify-center rounded-lg border border-border text-muted transition-colors hover:bg-surface hover:text-ink"
  aria-label="Switch light or dark theme"
  title="Switch light or dark theme"
>
  <Sun class="hidden dark:block" size={16} aria-hidden="true" />
  <Moon class="block dark:hidden" size={16} aria-hidden="true" />
</button>

<script>
  // The initial theme is set inline in BaseLayout before first paint.
  for (const button of document.querySelectorAll('.theme-toggle')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }
</script>
