---
import { cx } from '../../lib/cx';

interface Props {
  /** Small label above the title, styled like the CV's section headings. */
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const { eyebrow, title, lead, as: Heading = 'h2', id, class: className } = Astro.props;
---

<div class={cx('max-w-2xl', className)}>
  {eyebrow && (
    <p class="mb-3 flex items-center gap-2.5 font-mono text-xs font-medium tracking-[0.12em] text-muted uppercase">
      <span class="h-0.5 w-3 rounded-full bg-accent" aria-hidden="true" />
      {eyebrow}
    </p>
  )}
  <!-- Headings carry the message: people scan headings first (NN/g "layer-cake" pattern). -->
  <Heading id={id} class="scroll-mt-24 text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl">
    {title}
  </Heading>
  {lead && <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">{lead}</p>}
</div>
