---
import { cx } from '../../lib/cx';

interface Figure {
  value: string;
  label: string;
}

interface Props {
  figures: Figure[];
  class?: string;
}

const { figures, class: className } = Astro.props;
---

<!-- A strip with hairline dividers, not boxes (same as the CV). -->
<dl class={cx('grid grid-cols-2 gap-px border-y border-border bg-border sm:grid-cols-4', className)}>
  {figures.map(({ value, label }) => (
    <div class="flex flex-col-reverse bg-bg px-4 py-5 sm:px-5">
      <dt class="mt-1.5 text-sm leading-snug text-muted">{label}</dt>
      <dd class="text-3xl font-semibold tracking-tight text-ink tabular-nums">{value}</dd>
    </div>
  ))}
</dl>
