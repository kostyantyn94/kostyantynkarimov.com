---
import { cx } from '../../lib/cx';

interface Props {
  /** Renders the card as a link. */
  href?: string;
  as?: 'div' | 'article' | 'li';
  /** Hover lift without a link, e.g. for a card with its own button inside. */
  interactive?: boolean;
  class?: string;
}

const { href, as = 'div', interactive = false, class: className } = Astro.props;
const Tag = href ? 'a' : as;
---

<Tag
  href={href}
  class={cx(
    'block rounded-xl border border-border bg-surface p-5',
    (href || interactive) &&
      'transition-[border-color,translate] duration-200 ease-out-soft hover:-translate-y-0.5 hover:border-border-strong',
    className,
  )}
>
  <slot />
</Tag>
