---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Section from './Section.astro';
import { projects } from '../../data/profile';
---

<Section
  id="projects"
  eyebrow="Projects"
  title="Two systems I built end to end."
  lead="Open source and runnable with one command. The numbers come from real runs."
>
  <div class="grid gap-3 lg:grid-cols-2">
    {projects.map(({ name, title, date, repo, solves, how, proof, stack }) => (
      <Card as="article" class="flex flex-col gap-6 p-6 sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-mono text-[11px] tracking-wider text-muted uppercase">{date} · Open source</p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">{name}</h3>
            <p class="mt-1 text-muted">{title}</p>
          </div>
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center gap-1 rounded-lg border border-border px-2.5 py-1.5 text-xs text-muted transition-colors hover:border-border-strong hover:text-ink"
          >
            GitHub <ArrowUpRight size={14} aria-hidden="true" />
          </a>
        </div>

        <p class="leading-relaxed">{solves}</p>

        <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-border bg-border">
          {proof.map(({ value, label }) => (
            <div class="flex flex-col-reverse bg-bg px-3 py-4 sm:px-4">
              <dt class="mt-1 text-xs leading-snug text-muted">{label}</dt>
              <dd class="text-xl font-semibold tracking-tight tabular-nums sm:text-2xl">{value}</dd>
            </div>
          ))}
        </dl>

        <ul class="space-y-2 text-sm leading-relaxed text-muted">
          {how.map((step) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-px w-3 shrink-0 bg-faint" aria-hidden="true" />
              {step}
            </li>
          ))}
        </ul>

        <div class="mt-auto flex flex-wrap gap-1.5">
          {stack.map((tool, index) => (
            <Chip strong={index === 0}>{tool}</Chip>
          ))}
        </div>
      </Card>
    ))}
  </div>
</Section>
