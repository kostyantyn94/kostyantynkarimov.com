---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Download from '@lucide/astro/icons/download';
import Mail from '@lucide/astro/icons/mail';
import AvailabilityBadge from '../ui/AvailabilityBadge.astro';
import Backdrop from '../ui/Backdrop.astro';
import Button from '../ui/Button.astro';
import { profile } from '../../data/profile';
---

<section id="contact" class="scroll-mt-16 border-t border-border py-20 sm:py-28" aria-labelledby="contact-title">
  <div class="relative overflow-hidden rounded-3xl border border-border bg-surface/60 px-6 py-14 sm:px-12 sm:py-20">
    <Backdrop />
    <div class="relative max-w-2xl">
      <AvailabilityBadge>
        {profile.availability} · {profile.timezone}
      </AvailabilityBadge>
      <h2 id="contact-title" class="mt-6 text-4xl font-semibold tracking-[-0.04em] sm:text-5xl">
        Have a process that should run itself?
      </h2>
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        I'm open to remote roles and contract work in AI automation and integrations. Based in {profile.timezone}, I
        overlap with European working hours.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={`mailto:${profile.email}`}>
          <Mail aria-hidden="true" /> Email me
        </Button>
        <Button href={profile.links.linkedin} variant="secondary" external>
          LinkedIn <ArrowUpRight aria-hidden="true" />
        </Button>
        <Button href={profile.links.github} variant="secondary" external>
          GitHub <ArrowUpRight aria-hidden="true" />
        </Button>
        <Button href={profile.cv} variant="ghost" download>
          <Download aria-hidden="true" /> CV
        </Button>
      </div>
      <p class="mt-6 font-mono text-sm text-muted select-all">{profile.email}</p>
    </div>
  </div>
</section>
