---
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
}

const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="scroll-mt-16 border-t border-border py-20 sm:py-28" aria-labelledby={`${id}-title`}>
  <SectionHeading eyebrow={eyebrow} title={title} lead={lead} id={`${id}-title`} />
  <div class="mt-12">
    <slot />
  </div>
</section>
