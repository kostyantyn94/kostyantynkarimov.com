---
import Section from './Section.astro';
import { principles } from '../../data/profile';
---

<Section
  id="approach"
  eyebrow="Approach"
  title="How I build automations that keep running."
  lead="The same seven rules in every pipeline on this page."
>
  <ol class="grid gap-x-10 sm:grid-cols-2">
    {principles.map(({ title, text }, index) => (
      <li class="flex gap-5 border-t border-border py-6">
        <span class="font-mono text-xs leading-6 text-muted">{String(index + 1).padStart(2, '0')}</span>
        <div>
          <h3 class="font-semibold">{title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{text}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>
