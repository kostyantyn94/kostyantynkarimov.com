---
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import Section from './Section.astro';
import { infra, skills } from '../../data/profile';
---

<Section id="skills" eyebrow="Skills" title="What I do, and the tools I do it with.">
  <div class="grid gap-3 md:grid-cols-2">
    {skills.map(({ title, text, tools }) => (
      <Card as="article" class="flex flex-col gap-4">
        <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
        <p class="text-sm leading-relaxed text-muted">{text}</p>
        <div class="mt-auto flex flex-wrap gap-1.5">
          {tools.map((tool) => (
            <Chip>{tool}</Chip>
          ))}
        </div>
      </Card>
    ))}
  </div>
  <p class="mt-6 text-sm leading-relaxed text-muted">
    <span class="font-medium text-ink">Data and infrastructure:</span> {infra.join(' · ')}
  </p>
</Section>
