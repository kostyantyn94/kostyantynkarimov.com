---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Search from '@lucide/astro/icons/search';
import Card from '../ui/Card.astro';
import PipelineMini from '../ui/PipelineMini.astro';
import photo from '../../assets/photo.jpg';
import { keyFigures, profile, stack } from '../../data/profile';

const [rulesFirst, leadsByRules, repeatRun] = keyFigures;
const label = 'font-mono text-[11px] tracking-wider text-muted uppercase';
---

<!-- Proof at a glance: the second screen, scanned for numbers and names. -->
<section class="mt-16 grid gap-3 sm:mt-20 sm:grid-cols-6 lg:grid-cols-12" aria-label="Overview">
  <Card as="article" class="flex flex-col sm:col-span-6 lg:col-span-4 lg:row-span-2">
    <Image
      src={photo}
      alt={profile.name}
      width={160}
      height={160}
      loading="eager"
      class="size-20 rounded-xl object-cover"
    />
    <!-- What a remote employer checks: time zone overlap, remote track record, languages. -->
    <dl class="mt-6 space-y-3 border-t border-border pt-5 text-sm lg:mt-auto">
      <div>
        <dt class={label}>Based in</dt>
        <dd class="mt-0.5">
          {profile.location} · {profile.timezone}
        </dd>
      </div>
      <div>
        <dt class={label}>Remote</dt>
        <dd class="mt-0.5">{profile.remote}</dd>
      </div>
      <div>
        <dt class={label}>Languages</dt>
        <dd class="mt-0.5">{profile.languages}</dd>
      </div>
    </dl>
  </Card>

  <Card href="#playground" class="group flex flex-col gap-6 sm:col-span-6 lg:col-span-8">
    <div class="flex items-center justify-between gap-3">
      <p class={label}>Live pipeline · Level 4</p>
      <ArrowUpRight
        size={16}
        class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        aria-hidden="true"
      />
    </div>
    <PipelineMini
      nodes={[
        { name: 'Webhook', status: 'ok' },
        { name: 'Rules', status: 'ok' },
        { name: 'LLM', status: 'running' },
        { name: 'CRM', status: 'idle' },
      ]}
    />
    <p class="text-sm text-muted">
      Submit a lead and watch it travel through the workflow into a CRM. Then take the CRM down.
    </p>
  </Card>

  <Card as="article" class="sm:col-span-3 lg:col-span-4">
    <p class="text-5xl font-semibold tracking-[-0.04em] tabular-nums">{rulesFirst.value}</p>
    <p class="mt-3 text-sm leading-snug text-muted">{rulesFirst.label}</p>
  </Card>

  <Card href="#playground" class="group flex flex-col gap-4 sm:col-span-3 lg:col-span-4">
    <p class={label}>Ask my CV · RAG</p>
    <span class="flex items-center gap-2 rounded-lg border border-border bg-bg px-3 py-2.5 text-sm text-muted transition-colors group-hover:border-border-strong">
      <Search size={15} aria-hidden="true" />
      Has he built RAG on a vector database?
    </span>
    <p class="mt-auto text-sm text-muted">Hybrid search over pgvector, answers with sources.</p>
  </Card>

  <Card as="article" class="sm:col-span-6 lg:col-span-6">
    <p class={label}>Stack</p>
    <dl class="mt-4 space-y-3">
      {stack.map(({ group, items }) => (
        <div class="grid gap-1 sm:grid-cols-[7.5rem_1fr]">
          <dt class="text-sm text-muted">{group}</dt>
          <dd class="text-sm">{items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </Card>

  {[leadsByRules, repeatRun].map(({ value, label: text }) => (
    <Card as="article" class="sm:col-span-3 lg:col-span-3">
      <p class="text-5xl font-semibold tracking-[-0.04em] tabular-nums">{value}</p>
      <p class="mt-3 text-sm leading-snug text-muted">{text}</p>
    </Card>
  ))}
</section>
