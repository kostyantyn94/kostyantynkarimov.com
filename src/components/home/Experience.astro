---
import Download from '@lucide/astro/icons/download';
import Chip from '../ui/Chip.astro';
import Section from './Section.astro';
import { experience, profile } from '../../data/profile';
---

<Section
  id="experience"
  eyebrow="Experience"
  title="4+ years remote, from IT support to AI integrations."
  lead="I came into tech through IT support, so I debug calmly and explain trade-offs to non-technical people."
>
  <ol class="divide-y divide-border border-y border-border">
    {experience.map(({ period, title, company, points, tags }) => (
      <li class="grid gap-3 py-7 sm:grid-cols-[11rem_1fr] sm:gap-8">
        <p class="font-mono text-xs leading-6 text-muted">{period}</p>
        <div>
          <h3 class="font-semibold">
            {title} <span class="font-normal text-muted">· {company}</span>
          </h3>
          {points && (
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
              {points.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 h-px w-3 shrink-0 bg-faint" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
          )}
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <Chip>{tag}</Chip>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ol>
  <a
    href={profile.cv}
    download
    class="mt-8 inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink"
  >
    <Download size={15} aria-hidden="true" /> Full CV (PDF)
  </a>
</Section>
