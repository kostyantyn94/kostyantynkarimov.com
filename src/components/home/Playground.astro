---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import AudioLines from '@lucide/astro/icons/audio-lines';
import Card from '../ui/Card.astro';
import LevelBadge from '../ui/LevelBadge.astro';
import StatusPill from '../ui/StatusPill.astro';
import Section from './Section.astro';
import { demos, voiceDemo } from '../../data/profile';
---

<Section
  id="playground"
  eyebrow="Playground"
  title="Don't take my word for it. Run it."
  lead="Six demos, from a webhook to a full pipeline. Each one runs real code, and the code is one tab away. They go live one by one."
>
  <ul class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
    {demos.map(({ slug, level, title, summary, proves, live }) => (
      <li class="flex">
        <Card href={live ? `/playground/${slug}` : undefined} as="article" class="group flex w-full flex-col gap-4">
          <LevelBadge level={level} />
          <div class="space-y-2">
            <h3 class="text-lg font-semibold tracking-tight">{title}</h3>
            <p class="text-sm leading-relaxed text-muted">{summary}</p>
          </div>
          <p class="mt-auto border-t border-border pt-4 text-xs leading-relaxed text-muted">
            <span class="font-medium text-ink">What this proves:</span> {proves}
          </p>
          {live ? (
            <span class="inline-flex items-center gap-1.5 text-sm font-medium">
              Try it
              <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          ) : (
            <StatusPill status="idle" class="self-start">
              in progress
            </StatusPill>
          )}
        </Card>
      </li>
    ))}
  </ul>

  <Card as="article" class="mt-3 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <div class="flex items-start gap-4">
      <span class="grid size-10 shrink-0 place-items-center rounded-xl border border-border bg-bg text-muted">
        <AudioLines size={18} aria-hidden="true" />
      </span>
      <div class="space-y-1.5">
        <p class="font-mono text-[11px] tracking-wider text-muted uppercase">Bonus</p>
        <h3 class="text-lg font-semibold tracking-tight">{voiceDemo.title}</h3>
        <p class="max-w-xl text-sm leading-relaxed text-muted">{voiceDemo.summary}</p>
      </div>
    </div>
    <div class="flex shrink-0 flex-col gap-3 md:items-end md:text-right">
      <p class="max-w-xs text-xs leading-relaxed text-muted">
        <span class="font-medium text-ink">What this proves:</span> {voiceDemo.proves}
      </p>
      <StatusPill status="idle" class="self-start md:self-end">
        in progress
      </StatusPill>
    </div>
  </Card>
</Section>
