---
import Button from './ui/Button.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { profile } from '../data/profile';

// Section anchors until the pages exist (phase 2).
const nav = [
  { label: 'Playground', href: '/#playground' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
];
---

<header class="relative z-10 mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
  <a href="/" class="flex items-center gap-2.5 text-sm font-medium">
    <span class="grid size-7 place-items-center rounded-md bg-ink text-[13px] font-semibold text-bg" aria-hidden="true">
      K
    </span>
    <span class="hidden sm:inline">{profile.name}</span>
  </a>
  <nav class="flex items-center gap-1 text-sm text-muted" aria-label="Main">
    {nav.map(({ label, href }) => (
      <a class="hidden rounded-md px-3 py-1.5 transition-colors hover:text-ink md:block" href={href}>
        {label}
      </a>
    ))}
    <ThemeToggle />
    <Button href="/cv" size="sm" variant="secondary" class="ml-1">
      CV
    </Button>
  </nav>
</header>
