---
import Menu from '@lucide/astro/icons/menu';
import Button from './ui/Button.astro';
import ThemeToggle from './ui/ThemeToggle.astro';
import { profile } from '../data/profile';

const nav = [
  { label: 'Playground', href: '/#playground' },
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header sticky top-0 z-40 border-b border-transparent transition-colors duration-200">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 text-sm font-medium">
      <span
        class="grid size-7 place-items-center rounded-md bg-ink text-[13px] font-semibold text-bg"
        aria-hidden="true"
      >
        K
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>
    <nav class="flex items-center gap-1 text-sm" aria-label="Main">
      {nav.map(({ label, href }) => (
        <a
          class="nav-link hidden rounded-md px-3 py-1.5 text-muted transition-colors hover:text-ink md:block"
          href={href}
        >
          {label}
        </a>
      ))}
      <ThemeToggle />
      <Button href={profile.cv} size="sm" variant="secondary" class="ml-1" download>
        CV
      </Button>
      <details class="mobile-menu relative md:hidden">
        <summary
          class="ml-1 inline-flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-muted hover:text-ink"
          aria-label="Open menu"
        >
          <Menu size={16} aria-hidden="true" />
        </summary>
        <div class="absolute top-11 right-0 w-48 rounded-xl border border-border bg-surface p-1.5 shadow-2xl">
          {nav.map(({ label, href }) => (
            <a class="block rounded-lg px-3 py-2 text-ink hover:bg-surface-2" href={href}>
              {label}
            </a>
          ))}
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  .site-header[data-scrolled] {
    border-color: var(--border);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-link[aria-current='true'] {
    color: var(--ink);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Close the mobile menu after a link is chosen.
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.open = false;
  });

  // Highlight the nav link of the section in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.nav-link')].map((link) => [link.hash.slice(1), link]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const [id, link] of links) link.setAttribute('aria-current', String(id === entry.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
</script>
