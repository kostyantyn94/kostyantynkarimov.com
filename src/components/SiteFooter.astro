---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      © {year} {profile.name}
    </p>
    <p>
      Built with Astro and TypeScript.{' '}
      <a
        href={profile.links.source}
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink underline decoration-border-strong underline-offset-4 hover:decoration-ink"
      >
        Source on GitHub
      </a>
    </p>
  </div>
</footer>
