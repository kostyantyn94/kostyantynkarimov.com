---
// Source of public/og.png (the social preview). Not linked, not indexed.
// Regenerate after changes: screenshot this page at exactly 1200×630 and save it as public/og.png.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { Image } from 'astro:assets';
import photo from '../assets/photo.jpg';
import { profile } from '../data/profile';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG image</title>
  </head>
  <body class="m-0">
    <div class="og relative flex h-[630px] w-[1200px] flex-col justify-between overflow-hidden bg-bg p-16 text-ink">
      <div aria-hidden="true" class="og-dots absolute inset-0"></div>
      <div aria-hidden="true" class="og-glow absolute -top-64 left-1/2 h-[600px] w-[1100px] -translate-x-1/2"></div>

      <div class="relative flex items-center justify-between">
        <span class="grid size-12 place-items-center rounded-xl bg-ink text-2xl font-semibold text-bg">K</span>
        <span class="inline-flex items-center gap-2.5 rounded-full border border-border bg-surface/70 px-4 py-2 text-lg text-muted">
          <span class="size-2.5 rounded-full bg-ok"></span>
          {profile.availability} · {profile.timezone}
        </span>
      </div>

      <div class="relative flex items-end justify-between gap-12">
        <div>
          <p class="text-[88px] leading-[0.95] font-semibold tracking-[-0.045em]">{profile.name}</p>
          <p class="mt-2 text-[56px] leading-[1.05] font-semibold tracking-[-0.04em] text-muted">{profile.title}</p>
          <p class="mt-8 font-mono text-xl text-muted">
            n8n · LLM pipelines · RAG · AI voice agents ↔ CRM · TypeScript
          </p>
        </div>
        <Image src={photo} alt="" width={320} height={320} class="size-40 shrink-0 rounded-3xl object-cover" />
      </div>
    </div>
  </body>
</html>

<style>
  .og-dots {
    background-image: radial-gradient(var(--dot) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 0%, #000 30%, transparent 100%);
  }

  .og-glow {
    background: radial-gradient(closest-side, var(--glow), transparent);
  }
</style>
