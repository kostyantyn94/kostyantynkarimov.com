---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Approach from '../components/home/Approach.astro';
import Contact from '../components/home/Contact.astro';
import Experience from '../components/home/Experience.astro';
import Overview from '../components/home/Overview.astro';
import Playground from '../components/home/Playground.astro';
import Projects from '../components/home/Projects.astro';
import Skills from '../components/home/Skills.astro';
import AvailabilityBadge from '../components/ui/AvailabilityBadge.astro';
import Backdrop from '../components/ui/Backdrop.astro';
import Button from '../components/ui/Button.astro';
import Download from '@lucide/astro/icons/download';
import Play from '@lucide/astro/icons/play';
import { profile } from '../data/profile';

const description =
  'AI automation & agents engineer: AI voice agents, LLM pipelines, RAG and CRM integrations on n8n, JavaScript and REST APIs. Try the live demos.';

// Structured data for search engines. No employer here on purpose: lead with skills and proof.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  url: Astro.site?.href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Uzhhorod', addressCountry: 'UA' },
  sameAs: [profile.links.github, profile.links.linkedin],
  knowsAbout: [
    'AI automation',
    'AI voice agents',
    'LLM pipelines',
    'Retrieval-augmented generation',
    'Vector databases',
    'CRM integrations',
    'n8n',
    'TypeScript',
  ],
  knowsLanguage: ['en', 'de', 'uk', 'ru'],
};
---

<BaseLayout title={`${profile.name} · ${profile.title}`} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <!-- overflow-x-clip (not hidden) keeps the sticky header working while clipping the backdrop. -->
  <div class="relative overflow-x-clip">
    <Backdrop />
    <SiteHeader />

    <main class="relative mx-auto max-w-6xl px-4 sm:px-6">
      <!-- Name first: it is what a recruiter looks for in the first seconds. -->
      <section class="pt-14 sm:pt-24">
        <AvailabilityBadge href="#contact">
          {profile.availability} · {profile.timezone}
        </AvailabilityBadge>
        <h1 class="mt-6 max-w-4xl text-display font-semibold">
          {profile.name}
          <span class="block text-muted">{profile.title}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{profile.pitch}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#playground">
            <Play aria-hidden="true" /> Try the playground
          </Button>
          <Button href={profile.cv} variant="secondary" download>
            <Download aria-hidden="true" /> Download CV
          </Button>
          <Button href={`mailto:${profile.email}`} variant="ghost">
            Email me
          </Button>
        </div>
      </section>

      <Overview />
      <div class="mt-20 sm:mt-28">
        <Playground />
        <Projects />
        <Experience />
        <Skills />
        <Approach />
        <Contact />
      </div>
    </main>
  </div>
  <SiteFooter />
</BaseLayout>
